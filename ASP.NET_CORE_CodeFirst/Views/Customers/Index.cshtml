@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="container py-5">
    <div class="d-flex justify-content-end align-items-end mb-5">
        
        <a asp-action="Create" asp-controller="Customers" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-bold">
            <i class="fa fa-user-plus me-2"></i> Add New Customer
        </a>
    </div>

    <div class="row">
        <div class="col-12">
            @foreach (var c in Model)
            {
                <div class="card customer-card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-body p-0">
                        
                        <div class="d-flex justify-content-between align-items-center p-4">
                            <div class="d-flex align-items-center">
                                <div class="position-relative">
                                    <img src="@c.Picture" width="60" height="60" class="rounded-circle object-fit-cover border border-3 border-white shadow-sm" alt="Avatar" />
                                    <div class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle" style="width: 14px; height: 14px;"></div>
                                </div>
                                <div class="ms-3">
                                    <h5 class="mb-0 fw-bold text-dark">@Html.DisplayFor(xx => c.CustomerName)</h5>
                                   
                                </div>
                            </div>
                            
                            <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                <a asp-action="Edit" asp-controller="Customers" asp-route-id="@c.CustomerId" class="btn btn-white btn-sm px-3 border-end">
                                    <i class="fa fa-edit text-primary"></i>
                                </a>
                                <a asp-action="Delete" asp-controller="Customers" asp-route-id="@c.CustomerId" class="btn btn-white btn-sm px-3">
                                    <i class="fa fa-trash-o text-danger"></i>
                                </a>
                            </div>
                        </div>

                        <div class="row g-0 border-top border-bottom bg-light bg-opacity-50">
                            <div class="col-md-3 p-4 border-end">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle"><i class="fa fa-phone"></i></div>
                                    <div>
                                        <label class="pro-label">Contact</label>
                                        <span class="pro-value">@Html.DisplayFor(xx => c.Phone)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 p-4 border-end">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle"><i class="fa fa-map-marker"></i></div>
                                    <div>
                                        <label class="pro-label">Location</label>
                                        <span class="pro-value">@Html.DisplayFor(xx => c.Address)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 p-4 border-end">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle"><i class="fa fa-calendar-check-o"></i></div>
                                    <div>
                                        <label class="pro-label">Purchase Date</label>
                                        <span class="pro-value text-muted">@Html.DisplayFor(xx => c.PurchaseDate)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 p-4">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle text-primary"><i class="fa fa-credit-card"></i></div>
                                    <div>
                                        <label class="pro-label">Payment Detail</label>
                                        <span class="pro-value fw-bold">@Html.DisplayFor(xx => c.TotalBill)</span>
                                        <div class="mt-1">
                                            @if (c.IsPaid)
                                            {
                                                <span class="badge badge-paid rounded-pill px-2">Paid</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-pending rounded-pill px-2">Pending</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-dark fw-bold m-0" style="font-size: 0.85rem;">
                                    <i class="fa fa-shopping-basket me-2 text-muted"></i> Transaction Items
                                </h6>
                            </div>
                            <div class="table-responsive rounded-3 border">
                                <table class="table table-hover table-custom align-middle mb-0">
                                    <thead class="text-uppercase text-muted">
                                        <tr>
                                            <th class="ps-4">Product Code</th>
                                            <th>Item Description</th>
                                            <th class="text-end pe-4">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in c.TransactionDetails)
                                        {
                                            <tr>
                                                <td class="ps-4"><code class="fw-bold text-primary">#@Html.DisplayFor(x => item.Product.ProductId)</code></td>
                                                <td class="fw-medium text-dark">@Html.DisplayFor(x => item.Product.ProductName)</td>
                                                <td class="text-end pe-4">
                                                    <span class="text-muted small"><i class="fa fa-check-circle-o text-success"></i> Verified</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
  
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* Card Styling & Hover Animation */
    .customer-card {
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.05);
        background: #ffffff;
    }

        .customer-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
            border-color: #0d6efd;
        }

    /* Pro Label Design */
    .pro-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: #adb5bd;
        display: block;
        margin-bottom: 2px;
    }

    .pro-value {
        font-size: 0.95rem;
        font-weight: 500;
        color: #2d3436;
    }

    /* Icon Container */
    .icon-circle {
        width: 42px;
        height: 42px;
        background: #f1f3f5;
        border-radius: 12px; /* Soft rounded corners */
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: #495057;
        transition: 0.3s;
    }

    .customer-card:hover .icon-circle {
        background: #e7f1ff;
        color: #0d6efd;
    }

    /* Badge Customization */
    .badge-paid {
        background-color: #e6fffa;
        color: #319795;
        border: 1px solid #b2f5ea;
    }

    .badge-pending {
        background-color: #fffaf0;
        color: #dd6b20;
        border: 1px solid #feebc8;
    }

    .table-custom thead {
        background-color: #f8f9fa;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }
</style>