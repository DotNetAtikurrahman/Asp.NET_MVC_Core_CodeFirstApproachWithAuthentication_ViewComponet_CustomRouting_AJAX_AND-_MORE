@model ClientVM
@{
    ViewData["Title"] = "Delete Customer";
}



<style>
    body {
        background-color: #fff5f5;
    }
    /* Subtle red tint for danger context */
    
    .form-card {
        border: none;
        border-radius: 15px;
        background: #ffffff;
    }

    .form-control-static {
        border-radius: 8px;
        border: 1px solid #f1f3f5;
        background-color: #f8f9fa !important;
        padding: 10px 15px;
        color: #495057;
    }

    .input-group-text {
        background-color: #f1f3f5;
        border-radius: 8px 0 0 8px;
        border: 1px solid #dee2e6;
        color: #dc3545; /* Red icons for danger */
        width: 45px;
        justify-content: center;
    }

    .section-title {
        font-weight: 600;
        color: #dc3545;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }

        .section-title i {
            margin-right: 12px;
        }

    .delete-image-preview {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 12px;
        border: 4px solid #fff;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
    }

    .alert-danger-soft {
        background-color: #fff5f5;
        border: 1px solid #feb2b2;
        color: #c53030;
    }
</style>

<div class="container py-5">
    <form id="frmDelete"
          asp-action="Delete"
          asp-controller="Customers"
          data-ajax-method="post"
          data-ajax-mode="replace"
          data-ajax-update="#panel"
          data-ajax-success="success"
          data-ajax="true" enctype="multipart/form-data">

        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="Picture" />

        <div id="panel" class="mb-4"></div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card form-card shadow-sm p-4 border-top border-4 border-danger">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="section-title">
                            <i class="fa fa-exclamation-triangle"></i> Confirm Deletion
                        </h4>
                        <img src="@Model.Picture" class="delete-image-preview" alt="Customer Photo" />
                    </div>
                    
                    <p class="text-muted small mb-4">Are you sure you want to permanently remove this customer? This action cannot be undone.</p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Customer Name</label>
                        <div class="input-group shadow-xs">
                            <span class="input-group-text"><i class="fa fa-user"></i></span>
                            <input asp-for="CustomerName" class="form-control form-control-static" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Phone</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-phone"></i></span>
                                <input asp-for="Phone" class="form-control form-control-static" readonly />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Purchase Date</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                <input asp-for="PurchaseDate" class="form-control form-control-static" type="date" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-map-marker"></i></span>
                            <input asp-for="Address" class="form-control form-control-static" readonly />
                        </div>
                    </div>

                    <div class="row align-items-center mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Final Bill</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-money"></i></span>
                                <input asp-for="TotalBill" class="form-control form-control-static fw-bold" readonly />
                            </div>
                        </div>
                        <div class="col-md-6 pt-4">
                            <div class="p-2 px-3 rounded-3 border bg-light text-muted small">
                                <i class="fa fa-info-circle me-1"></i> Paid Status: <b>@(Model.IsPaid ? "Paid" : "Unpaid")</b>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-danger w-100 py-2 rounded-pill shadow-sm fw-bold">
                            <i class="fa fa-trash me-2"></i> Yes, Delete Customer
                        </button>
                        <a asp-action="Index" class="btn btn-link w-100 mt-2 text-decoration-none text-muted small">No, Keep Customer</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card form-card shadow-sm p-4 h-100 border-top border-4 border-secondary">
                    <h4 class="section-title text-secondary">
                        <i class="fa fa-history"></i> Associated Products
                    </h4>
                    <p class="text-muted small">Deleting this customer will also remove the following product transaction records:</p>

                    <div id="productContainer" class="rounded-4 border bg-light p-2">
                        @foreach (var item in Model.ProductList)
                        {
                            <script>
                                                        
                                                        LoadData(@item)
                            </script>
                        }
                    </div>
                    
                    <div class="mt-4 p-3 alert-danger-soft rounded-3 border">
                        <p class="small m-0">
                            <i class="fa fa-warning me-2"></i> <strong>Warning:</strong> All data related to <b>@Model.CustomerName</b> will be scrubbed from the database.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/ajax/dist/jquery.unobtrusive-ajax.js"></script>

    <script>
        function success(){
        $("#frmDelete").trigger('reset')
        }
    </script>

}