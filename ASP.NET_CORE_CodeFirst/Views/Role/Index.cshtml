
@{
    ViewData["Title"] = "Role Management";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0 fs-4">
                        <i class="bi bi-gear-wide-connected me-2"></i>Role Management
                    </h3>
                    <span class="badge bg-primary">System Security</span>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.msg != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.msg
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="bg-light p-4 rounded-3 border">
                        <h5 class="text-secondary mb-3">Create New System Role</h5>
                        <form asp-action="CreateRole" asp-controller="Role" method="post">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-7">
                                    <label class="form-label fw-bold small text-uppercase text-muted">Role Name</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-shield-plus"></i></span>
                                        <input type="text"
                                               name="userRole"
                                               class="form-control"
                                               placeholder="e.g. Administrator, Manager, Editor"
                                               required />
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <button class="btn btn-primary w-100 shadow-sm" type="submit">
                                        <i class="bi bi-plus-lg me-2"></i>Create Role
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="mt-5">
                        <p class="text-muted small text-center italic">Manage your application permission levels from this central dashboard.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>